{
  "name": "xsplay",
  "version": "1.0.0",
  "description": "XREAL Air SBS Video Player",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite --config vite.config.ts\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "rebuild": "electron-rebuild",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "keywords": ["xreal", "sbs", "spatial-video", "electron"],
  "author": "renorari",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-deb": "^7.7.0",
    "@electron-forge/maker-dmg": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "node-hid": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
